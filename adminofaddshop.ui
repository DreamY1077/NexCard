  <property name="styleSheet">
   <string notr="true">/* 弹窗顶层背景（替换成你自己的对象名） */
#AddGoodsDialog
{
    background-image: url(:/res/LoginBackgroundImage.png);
    background-repeat: no-repeat;
    background-position: center;
}

/* 承载所有控件的磨砂容器 */
#addGoodsContainer
{
    background-color:rgba(255,255,255,160);
    border-radius:16px;
}

/* 文字标签：商品名称、单价、库存、商品信息 */
QLabel
{
    font-size:16px;
    color:#222222;
    background-color:transparent;
}

/* 四个输入框 QLineEdit */
QLineEdit
{
    border:1px solid rgba(160,180,200,130);
    border-radius:8px;
    padding:6px 10px;
    background-color:rgba(255,255,255,200);
    font-size:14px;
}
QLineEdit:focus
{
    border:1px solid rgba(120,140,160,170);
    background-color:rgba(255,255,255,240);
}

/* 按钮：清空、确认添加 */
QPushButton
{
    background-color: rgba(255,255,255,140);
    color:#222222;
    border:1px solid rgba(170,185,200,120);
    border-radius:10px;
    padding:8px 16px;
    font-size:15px;
}
QPushButton:hover
{
    background-color:rgba(255,255,255,200);
}
QPushButton:pressed
{
    background-color:rgba(230,238,245,210);
}</string>
