/* ============================================================
   NexCard（新卡智联）全局样式表
   设计 Token：主色 #4287d8 / 成功 #27ae60 / 警告 #f0ad4e / 危险 #d9534f
   风格：浅色 · 玻璃质感 · 统一圆角
   ============================================================ */

/* ---------- 全局字体 ---------- */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* ---------- 主窗口 / 对话框 ---------- */
QDialog {
    background-color: #f7fafd;
}
/* 登录整体卡片 */
QWidget#cardPanel {
    background-color: rgba(255,255,255,0.94);
    border: 1px solid rgba(180,195,210,0.5);
    border-radius: 18px;
}
/* 品牌 Logo（渐变圆角方块） */
QLabel#logoLabel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4287d8, stop:1 #5b9bd5);
    color: #ffffff;
    font-size: 30px;
    font-weight: bold;
    border-radius: 16px;
}
/* 品牌标题 */
QLabel#titleLabel {
    color: #2c3e50;
    font-size: 24px;
    font-weight: bold;
    margin-top: 6px;
}
/* 品牌副标题 */
QLabel#subLabel {
    color: #8a9bb0;
    font-size: 13px;
    margin-bottom: 10px;
}

/* ---------- 分段切换器（登录页） ---------- */
QPushButton[segment="true"] {
    background-color: #eef3f9;
    color: #5a6b80;
    border: 1px solid rgba(170,185,200,100);
    border-radius: 0;
    padding: 9px 0;
    font-size: 13.5px;
    font-weight: 500;
}
QPushButton[segment="true"]:first {
    border-radius: 14px 0 0 14px;
    border-right: none;
}
QPushButton[segment="true"]:middle {
    border-right: none;
}
QPushButton[segment="true"]:last {
    border-radius: 0 14px 14px 0;
}
QPushButton[segment="true"]:hover {
    background-color: #e2edf9;
    color: #4287d8;
}
QPushButton[segment="true"]:checked {
    background-color: #ffffff;
    color: #4287d8;
    border-color: #4287d8;
    font-weight: 700;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: rgba(255,255,255,150);
    color: #222222;
    border: 1px solid rgba(170,185,200,120);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: rgba(255,255,255,210);
    border-color: rgba(120,155,190,150);
}
QPushButton:pressed {
    background-color: rgba(230,238,245,220);
}
QPushButton:disabled {
    color: #999999;
    background-color: rgba(235,240,245,140);
    border-color: rgba(200,210,220,100);
}
/* 主色按钮（对象名 primaryBtn） */
QPushButton#primaryBtn {
    background-color: #4287d8;
    color: #ffffff;
    border: 1px solid #3476c2;
    font-weight: 600;
}
QPushButton#primaryBtn:hover {
    background-color: #3476c2;
}
QPushButton#primaryBtn:pressed {
    background-color: #2c65ac;
}
/* 危险按钮（对象名 dangerBtn） */
QPushButton#dangerBtn {
    color: #d9534f;
    border: 1px solid rgba(217,83,79,120);
}
QPushButton#dangerBtn:hover {
    background-color: rgba(217,83,79,25);
    border-color: #d9534f;
}
/* 主操作按钮（动态属性 primary="true"，用于登录/注册/确认按钮） */
QPushButton[primary="true"] {
    background-color: #4287d8;
    color: #ffffff;
    border: 1px solid #3476c2;
    font-weight: 600;
    padding: 9px 24px;
    font-size: 15px;
    border-radius: 10px;
}
QPushButton[primary="true"]:hover {
    background-color: #3476c2;
}
QPushButton[primary="true"]:pressed {
    background-color: #2c65ac;
}
QPushButton[primary="true"]:disabled {
    background-color: #9db9dc;
    border-color: #8aa9cc;
}

/* ---------- 输入框 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid #c9d8ea;
    border-radius: 8px;
    padding: 6px 10px;
    background-color: rgba(255,255,255,220);
    font-size: 14px;
    color: #222222;
    selection-background-color: #4287d8;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #4287d8;
    background-color: rgba(255,255,255,250);
}
QLineEdit:read-only {
    color: #777777;
    background-color: rgba(240,244,248,180);
}
QLineEdit:disabled {
    color: #999999;
    background-color: rgba(235,240,245,140);
}

/* ---------- 下拉框 ---------- */
QComboBox {
    background-color: rgba(255,255,255,210);
    border: 1px solid #c9d8ea;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 14px;
    color: #222222;
}
QComboBox:hover { border-color: rgba(120,155,190,160); }
QComboBox:focus { border-color: #4287d8; }
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: rgba(255,255,255,240);
    border: 1px solid rgba(170,185,200,140);
    border-radius: 6px;
    outline: none;
    selection-background-color: #4287d8;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item {
    height: 30px;
    padding-left: 8px;
    color: #222222;
}

/* ---------- 表格（含斑马纹） ---------- */
QTableWidget, QTableView {
    background-color: rgba(255,255,255,180);
    alternate-background-color: rgba(243,248,253,200);
    border: 1px solid rgba(175,190,205,130);
    border-radius: 8px;
    gridline-color: rgba(190,205,220,120);
    outline: none;
    font-size: 13px;
}
QTableWidget::item, QTableView::item {
    padding: 5px 8px;
    color: #222222;
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: rgba(230,241,252,200);
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgba(200,222,244,200);
    color: #111111;
}
QHeaderView::section {
    background-color: #eef4fa;
    border: none;
    border-bottom: 1px solid rgba(180,195,210,140);
    border-right: 1px solid rgba(180,195,210,140);
    padding: 8px;
    color: #3a4a5d;
    font-weight: 600;
    font-size: 13px;
}
QTableCornerButton::section {
    background-color: #eef4fa;
    border: none;
}

/* ---------- 树形菜单 ---------- */
QTreeWidget, QTreeView {
    background-color: rgba(255,255,255,170);
    border: 1px solid rgba(190,205,220,120);
    border-radius: 10px;
    outline: none;
    font-size: 14px;
}
QTreeWidget::item, QTreeView::item {
    height: 36px;
    color: #222222;
    padding-left: 6px;
    border-radius: 6px;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: rgba(240,246,253,220);
}
QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: rgba(215,228,242,220);
    color: #111111;
}
QTreeWidget::branch, QTreeView::branch {
    background-color: transparent;
}
QTreeWidget::branch:has-children, QTreeView::branch:has-children {
    background-color: transparent;
}

/* ---------- 页签 ---------- */
QTabWidget::pane {
    border: 1px solid rgba(180,195,210,140);
    border-radius: 8px;
    background-color: rgba(255,255,255,150);
    top: -1px;
}
QTabBar::tab {
    background-color: rgba(255,255,255,120);
    border: 1px solid rgba(170,185,200,130);
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 7px 14px;
    margin-right: 4px;
    color: #444444;
    font-size: 13px;
}
QTabBar::tab:hover {
    background-color: rgba(255,255,255,190);
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #4287d8;
    font-weight: 600;
    border-bottom: 2px solid #4287d8;
}
QTabBar::close-button {
    width: 14px;
    height: 14px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QTabBar::close-button:hover {
    background: rgba(217,83,79,150);
    border-radius: 7px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    width: 9px;
    background: transparent;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(150,170,190,150);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(120,140,160,200);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    height: 9px;
    background: transparent;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(150,170,190,150);
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(120,140,160,200);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 单选/复选（普通圆圈 indicator，仅性别 QRadioButton 使用） ---------- */
QRadioButton {
    font-size: 13.5px;
    color: #222222;
    spacing: 8px;
    min-height: 22px;
    padding: 2px 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1.5px solid #8aa8c8;
    background: #ffffff;
}
QRadioButton::indicator:hover {
    border-color: #4287d8;
}
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.45,
        fx:0.5, fy:0.5, stop:0 #ffffff, stop:0.4 #ffffff, stop:0.45 #4287d8, stop:1 #4287d8);
    border: 1.5px solid #4287d8;
}

QCheckBox {
    font-size: 13.5px;
    color: #222222;
    spacing: 8px;
    min-height: 22px;
    padding: 2px 0;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #8aa8c8;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #4287d8;
}
QCheckBox::indicator:checked {
    background-color: #4287d8;
    border: 1.5px solid #3476c2;
}

/* ---------- 分组框 / 标签 ---------- */
QGroupBox {
    border: 1px solid rgba(170,185,200,120);
    border-radius: 10px;
    margin-top: 12px;
    font-size: 13px;
    color: #444444;
    background-color: rgba(255,255,255,90);
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #4287d8;
    font-weight: 600;
}
QLabel {
    color: #222222;
    background-color: transparent;
}

/* ---------- 消息框（品牌化弹窗） ---------- */
QMessageBox {
    background-color: #ffffff;
    border: 1px solid #e0e7f0;
    border-radius: 14px;
    /* 关键：不强制 min-width，让 Qt 根据文字+图标自动计算 */
}
/* 消息文本 label：去 min-width，避免把弹窗撑得过宽 */
QMessageBox QLabel {
    color: #222222;
    font-size: 13.5px;
    padding: 12px 4px 12px 4px;
}
/* 消息框按钮 */
QMessageBox QPushButton {
    min-width: 72px;
    padding: 7px 22px;
    border-radius: 8px;
    /* 强制最小高度避免被父布局压扁 */
    min-height: 26px;
}
QMessageBox QPushButton:default {
    background-color: #4287d8;
    color: #ffffff;
    border: 1px solid #3476c2;
    font-weight: 600;
}
QMessageBox QPushButton:default:hover {
    background-color: #3476c2;
}
QMessageBox QPushButton:default:pressed {
    background-color: #2c65ac;
}

/* ---------- 提示 ---------- */
QToolTip {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #c9d8ea;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

/* ---------- 状态栏 / 停靠面板 ---------- */
QStatusBar {
    background-color: rgba(255,255,255,120);
    color: #666666;
}

/* ======== 欢迎页信息卡片 ======== */
QFrame#identityCard, QFrame#serialCard, QFrame#timeCard {
    background-color: #ffffff;
    border: 1px solid #e0e7f0;
    border-radius: 12px;
}
QLabel#welcomeTitleLabel {
    color: #2c3e50;
    font-size: 22px;
    font-weight: bold;
}
QLabel#identityKeyLabel, QLabel#serialKeyLabel, QLabel#timeKeyLabel {
    color: #8a9bb0;
    font-size: 12.5px;
    padding: 6px 14px;
}
QLabel#identityValueLabel, QLabel#serialValueLabel, QLabel#timeValueLabel {
    color: #222222;
    font-size: 20px;
    font-weight: 700;
    padding: 2px 14px 12px 14px;
}
QFrame#identityCard QLabel, QFrame#serialCard QLabel, QFrame#timeCard QLabel {
    background-color: transparent;
}
QDockWidget {
    color: #222222;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: rgba(255,255,255,150);
    border: 1px solid rgba(170,185,200,130);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    padding: 6px 10px;
    font-size: 14px;
}
QDockWidget::widget {
    background-color: rgba(255,255,255,140);
    border: 1px solid rgba(170,185,200,130);
    border-top: none;
    border-radius: 0 0 8px 8px;
}

/* ---------- 人脸识别：摄像头预览区 ---------- */
QLabel#videoLabel {
    background-color: #1c2128;
    color: #7d8b9e;
    border: 1px solid #2c3542;
    border-radius: 10px;
}
